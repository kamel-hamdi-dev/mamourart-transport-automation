# Mamourart Transport Automation — email secrets
# Do not commit a real password or app password.

MAMOURART_EMAIL_SOURCE=imap
MAMOURART_IMAP_PROVIDER=custom
MAMOURART_IMAP_HOST=imap.example.com
MAMOURART_IMAP_PORT=993
MAMOURART_IMAP_USER=transport@example.com
MAMOURART_IMAP_PASSWORD=replace-locally-only
MAMOURART_IMAP_MAILBOX=INBOX
MAMOURART_IMAP_SEARCH=UNSEEN
MAMOURART_IMAP_MAX_MESSAGES=50
